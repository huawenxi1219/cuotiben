+        if raw:
+            target = datetime.strptime(raw, "%Y-%m-%d")
+        else:
+            now = datetime.now()
+            target = datetime(now.year, 6, 7)
+            if (target - now).total_seconds() < 0:
+                target = datetime(now.year + 1, 6, 7)
+        return max((target - datetime.now()).days, 0)
+    except BaseException:
+        return 365
