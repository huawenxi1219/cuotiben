+def resolve_deepseek_model(cfg):
+    """统一 DeepSeek 模型名：全文件只认 deepseek-flash 这一种写法。
+    旧名（deepseek-v4-flash 等）一律归一化为 deepseek-flash，与 load_ai_config 迁移一致。"""
